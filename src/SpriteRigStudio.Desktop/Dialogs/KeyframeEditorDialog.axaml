<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SpriteRigStudio.Desktop.Dialogs.KeyframeEditorDialog"
        Title="Add Keyframe" Width="350" Height="300"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="16" Spacing="8">
    <TextBlock Text="Keyframe Properties" FontWeight="Bold" />

    <Grid ColumnDefinitions="80,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
      <TextBlock Text="Time (s)" VerticalAlignment="Center" />
      <TextBox x:Name="TimeBox" Text="0.0" Grid.Column="1" />

      <TextBlock Text="Position X" Grid.Row="1" VerticalAlignment="Center" />
      <TextBox x:Name="PosXBox" Text="0" Grid.Row="1" Grid.Column="1" />

      <TextBlock Text="Position Y" Grid.Row="2" VerticalAlignment="Center" />
      <TextBox x:Name="PosYBox" Text="0" Grid.Row="2" Grid.Column="1" />

      <TextBlock Text="Rotation" Grid.Row="3" VerticalAlignment="Center" />
      <TextBox x:Name="RotBox" Text="0" Grid.Row="3" Grid.Column="1" />

      <TextBlock Text="Interpolation" Grid.Row="4" VerticalAlignment="Center" />
      <ComboBox x:Name="InterpCombo" Grid.Row="4" Grid.Column="1" SelectedIndex="1" />
    </Grid>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
      <Button Content="Cancel" Click="OnCancel" />
      <Button Content="Add Keyframe" Click="OnAdd" IsDefault="True" />
    </StackPanel>
  </StackPanel>
</Window>
