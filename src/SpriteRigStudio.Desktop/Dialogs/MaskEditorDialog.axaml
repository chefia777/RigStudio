<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SpriteRigStudio.Desktop.Controls"
        x:Class="SpriteRigStudio.Desktop.Dialogs.MaskEditorDialog"
        Title="Mask Editor" Width="700" Height="550"
        WindowStartupLocation="CenterOwner">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="4" Margin="8">
      <Button Content="Add Vertex" Click="OnAddVertex" />
      <Button Content="Remove Vertex" Click="OnRemoveVertex" />
      <Button Content="Close Polygon" Click="OnClosePolygon" />
      <Button Content="Clear" Click="OnClear" />
      <Separator Width="8" />
      <Button Content="Save Mask" Click="OnSave" IsDefault="True" />
      <Button Content="Cancel" Click="OnCancel" />
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="8" Orientation="Horizontal" Spacing="8">
      <TextBlock Text="Mask Name:" VerticalAlignment="Center" />
      <TextBox x:Name="MaskNameBox" Watermark="e.g. torso" Width="200" />
    </StackPanel>
    <Border BorderBrush="Gray" BorderThickness="1" Margin="8" ClipToBounds="True">
      <controls:MaskCanvas x:Name="Canvas" />
    </Border>
  </DockPanel>
</Window>
